# Copy to .env.local for local testing. On Vercel, set these in Project Settings > Environment Variables.
# Both values are public by design (Row Level Security protects the data). Never put the secret / service_role key here.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
# Set to true only after turning on Google in Supabase (Authentication > Sign In / Providers)
ENABLE_GOOGLE_SIGNIN=false
